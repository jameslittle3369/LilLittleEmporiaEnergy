# ---------------------------------------------------------------------------
# Emporia_Energy.py configuration
#
# Copy this file to .env and fill in your own values:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
#
# .env holds secrets -- never commit it.
# ---------------------------------------------------------------------------

# --- Emporia account (required) --------------------------------------------
# The same email + password you use in the Emporia mobile app.
EMPORIA_USERNAME=you@example.com
EMPORIA_PASSWORD=your-emporia-password

# Where to cache the auth tokens so every run does not re-authenticate.
# Delete this file if you change your password or hit auth errors.
EMPORIA_TOKEN_FILE=emporia_tokens.json


# --- Reporting behaviour ---------------------------------------------------
# IANA timezone used for day / month boundaries. Blank = this machine's local
# time. Set it to the timezone your Emporia account is configured for.
# Examples: America/New_York, America/Chicago, America/Denver, America/Los_Angeles
TIMEZONE=

# Days of daily history to pull. 30 is the minimum actually used; the script
# always extends the window far enough to cover month-to-date.
HISTORY_DAYS=30

# Pause between API calls, in seconds. Raise it if the Emporia cloud starts
# throttling (the run makes roughly one request per day of history).
REQUEST_DELAY_SECONDS=0.35

# Bucket used for the "current watts" reading: minute (steadier) or second
# (closer to instantaneous, but more often empty for individual circuits).
INSTANT_SCALE=minute

# How many circuits appear in each ranked bar chart, highest usage first.
CHART_TOP_N=15

# How many circuits get a line in the daily line chart. Capped at 8 -- past
# that the series colors stop being reliably distinguishable.
CHART_LINE_TOP_N=5

# Directory for generated chart PNGs and CSV files.
OUTPUT_DIR=reports

# Combine map: sums the two legs of a 240V circuit into one reported circuit.
# Generate one for your own panel with:
#     python Emporia_Energy.py --generate-circuit-map
# Missing file = no combining. Use --no-combine to ignore it for a single run.
CIRCUIT_MAP_FILE=circuit_map.json


# --- Gmail SMTP (only needed for --sendemail) ------------------------------
# Gmail requires an App Password, NOT your normal Google password:
#   Google Account -> Security -> 2-Step Verification -> App passwords
# Paste the 16-character value below (spaces are fine to remove).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=abcdefghijklmnop

# Envelope From. Leave blank to reuse SMTP_USER.
EMAIL_FROM=

# One or more recipients, comma separated.
EMAIL_TO=you@gmail.com

# Prefix for the subject line; the run timestamp is appended automatically.
EMAIL_SUBJECT_PREFIX=Emporia Energy Report

# Attach the summary table as a CSV file as well.
EMAIL_ATTACH_CSV=true
